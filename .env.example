# --- Obligatorias ---
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-api-key
# Nombre del índice de Pinecone (se crea automáticamente si no existe)
INDEX_NAME=screening-cvs

# --- Modelos (sin hard-coding en el código) ---
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con EMBEDDING_MODEL (1536 para text-embedding-3-small)
EMBEDDING_DIMENSION=1536

# --- Pinecone (la región solo se usa al crear el índice) ---
PINECONE_NAMESPACE=screening-cvs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Redis (docker compose lo sobrescribe con redis://redis:6379) ---
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# --- Comportamiento del grafo ---
# llm = el supervisor decide con el LLM (con guardrails) | rules = determinístico
SUPERVISOR_MODE=llm
MAX_ANALYSIS_RETRIES=2
MAX_RESEARCH_ATTEMPTS=2
RETRIEVAL_TOP_K=5

# --- Observabilidad (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=screening-cvs
